        </div>
      </div>

      <div class="col">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h5 class="fw-bold text-dark mb-2">Instant Confirmation</h5>
          <p class="text-muted small m-0">No waiting around. Book your stay instantly with zero booking delay.</p>
        </div>
      </div>

      <div class="col">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h5 class="fw-bold text-dark mb-2">24/7 Concierge Support</h5>
