<%- layout('layouts/boilerplate') -%>

<!-- ====================
     Hero Section
     ==================== -->
<section class="hero-section">
  <div class="container-xxl px-3 px-md-4">
    <div class="row align-items-center justify-content-center text-center">
      <div class="col-lg-10 col-xl-9">
        <div class="hero-badge mb-3">
          <i class="fa-solid fa-sparkles text-danger"></i>
          <span>10,000+ Handpicked Luxury Stays & Experiences</span>
        </div>
        <h1 class="hero-title mb-3">
          Find Your Next <span class="hero-title-gradient">Sanctuary</span> Anywhere in the World
        </h1>
        <p class="hero-subtitle mb-4 col-lg-10 mx-auto">
          Discover handpicked luxury villas, cozy beachfront cabins, historic castles, and unique stays with complete peace of mind.
        </p>

        <!-- Search Bar Widget -->
        <div class="search-widget-container mb-4 text-start">
          <form action="/listings" method="GET" id="heroSearchForm">
            <div class="row g-2 align-items-center">
              <!-- Location Field -->
              <div class="col-12 col-md-4 border-end-md">
                <div class="search-field px-2">
                  <label class="search-label" for="searchLocation">Where</label>
                  <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-location-dot text-danger"></i>
                    <input type="text" class="search-input" id="searchLocation" name="q" placeholder="Search destinations (e.g. Bali, Paris)" autocomplete="off">
                  </div>
                </div>
              </div>

              <!-- Dates Field -->
              <div class="col-6 col-md-3 border-end-md">
                <div class="search-field px-2">
                  <label class="search-label">When</label>
                  <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-muted"></i>
                    <input type="text" class="search-input" placeholder="Anytime / Select dates" onfocus="(this.type='date')" onblur="(this.type='text')">
                  </div>
                </div>
              </div>

              <!-- Guests Field -->
              <div class="col-6 col-md-3">
                <div class="search-field px-2">
                  <label class="search-label">Who</label>
                  <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-user-group text-muted"></i>
                    <span class="search-input text-truncate" id="guestCountDisplay">2 Guests, 1 Room</span>
                  </div>
                </div>
              </div>

              <!-- Search Button -->
              <div class="col-12 col-md-2 text-end">
                <button type="submit" class="search-btn-hero w-100">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <span>Search</span>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Quick Destinations Pills -->
        <div class="d-flex align-items-center justify-content-center flex-wrap gap-2">
          <span class="small text-muted fw-bold me-1">Popular:</span>
          <span class="quick-tag" onclick="selectQuickTag('Bali, Indonesia')">🏖️ Bali</span>
          <span class="quick-tag" onclick="selectQuickTag('Swiss Alps')">🏔️ Swiss Alps</span>
          <span class="quick-tag" onclick="selectQuickTag('Paris, France')">🗼 Paris</span>
          <span class="quick-tag" onclick="selectQuickTag('Jaipur, India')">🏰 Jaipur</span>
          <span class="quick-tag" onclick="selectQuickTag('Tokyo, Japan')">🌸 Tokyo</span>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ====================
     Categories & GST Switcher Bar
     ==================== -->
<section class="py-4 border-bottom bg-white sticky-top shadow-sm" style="top: 4.5rem; z-index: 10;">
  <div class="container-xxl px-3 px-md-4">
    <div class="d-flex align-items-center justify-content-between gap-3">
      <!-- Category Carousel Pills -->
      <div class="categories-container flex-grow-1">
        <div class="category-item active" onclick="filterCategory(this, 'all')">
          <i class="fa-solid fa-fire"></i>
          <span>Trending</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'beach')">
          <i class="fa-solid fa-umbrella-beach"></i>
          <span>Beachfront</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'iconic')">
          <i class="fa-solid fa-city"></i>
          <span>Iconic Cities</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'mountains')">
          <i class="fa-solid fa-mountain text-secondary"></i>
          <span>Mountains</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'castles')">
          <i class="fa-solid fa-chess-rook"></i>
          <span>Castles</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'pools')">
          <i class="fa-solid fa-person-swimming"></i>
          <span>Amazing Pools</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'cabins')">
          <i class="fa-solid fa-house-chimney-window"></i>
          <span>Cabins</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'camping')">
          <i class="fa-solid fa-campground"></i>
          <span>Camping</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'farms')">
          <i class="fa-solid fa-cow"></i>
          <span>Farms</span>
        </div>
        <div class="category-item" onclick="filterCategory(this, 'boats')">
          <i class="fa-solid fa-sailboat"></i>
          <span>Boats</span>
        </div>
      </div>

      <!-- GST Price Switcher -->
      <div class="tax-toggle-box d-none d-md-flex">
        <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
          <input class="form-check-input mt-0" type="checkbox" role="switch" id="gstToggle" onchange="toggleGST(this.checked)">
          <label class="form-check-label small fw-bold text-dark cursor-pointer" for="gstToggle">
            Display total after taxes (18% GST)
          </label>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ====================
     Featured Listings Grid
     ==================== -->
<section class="py-5">
  <div class="container-xxl px-3 px-md-4">
    <div class="d-flex align-items-end justify-content-between mb-4">
      <div>
        <span class="text-danger fw-bold text-uppercase small letter-spacing-1">Handpicked Collection</span>
        <h2 class="fw-extrabold text-dark m-0">Featured Stays & Retreats</h2>
      </div>
      <a href="/listings" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold">
        View All (<%= featuredListings.length > 0 ? featuredListings.length : 8 %>) <i class="fa-solid fa-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4" id="listingsContainer">
      <% if (featuredListings && featuredListings.length > 0) { %>
        <% for(let listing of featuredListings) { %>
          <div class="col listing-item" data-category="all">
            <a href="/listings/<%= listing._id %>" class="listing-card-wrapper">
              <div class="custom-card card">
                <div class="card-img-wrapper">
                  <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop' %>" 
                       class="card-img-top" 
                       alt="<%= listing.title %>"
                       loading="lazy">
                  <span class="card-badge">SUPERHOST</span>
                  <button class="wishlist-btn" type="button" onclick="event.preventDefault(); this.classList.toggle('active');">
                    <i class="fa-solid fa-heart"></i>
                  </button>
                </div>
                <div class="card-body card-body-custom">
                  <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title-custom m-0"><%= listing.title %></h5>
                    <div class="d-flex align-items-center gap-1 small fw-bold text-dark">
                      <i class="fa-solid fa-star text-warning"></i>
                      <span>4.95</span>
                    </div>
                  </div>
                  <p class="card-location-custom"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location || 'Exotic Stay' %>, <%= listing.country || 'Global' %></p>
                  <div class="d-flex align-items-baseline gap-1">
                    <span class="card-price-custom">&#8377;<span class="price-number" data-base-price="<%= listing.price %>"><%= listing.price ? listing.price.toLocaleString('en-IN') : '4,500' %></span></span>
                    <span class="text-muted fs-6">/ night</span>
                    <span class="tax-info ms-2">+18% GST</span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      <% } else { %>
        <!-- Fallback High-Quality Sample Stays when DB is empty -->
        <div class="col listing-item" data-category="beach">
          <a href="/listings" class="listing-card-wrapper">
            <div class="custom-card card">
              <div class="card-img-wrapper">
                <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Azure Oceanfront Villa">
                <span class="card-badge">SUPERHOST</span>
                <button class="wishlist-btn" type="button" onclick="event.preventDefault(); this.classList.toggle('active');"><i class="fa-solid fa-heart"></i></button>
              </div>
              <div class="card-body card-body-custom">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title-custom m-0">Azure Oceanfront Sanctuary</h5>
                  <div class="d-flex align-items-center gap-1 small fw-bold text-dark"><i class="fa-solid fa-star text-warning"></i> 4.98</div>
                </div>
                <p class="card-location-custom"><i class="fa-solid fa-location-dot me-1 text-danger"></i>Seminyak, Bali</p>
                <div class="d-flex align-items-baseline gap-1">
                  <span class="card-price-custom">&#8377;<span class="price-number" data-base-price="12500">12,500</span></span>
                  <span class="text-muted fs-6">/ night</span>
                  <span class="tax-info ms-2">+18% GST</span>
                </div>
              </div>
            </div>
          </a>
        </div>

        <div class="col listing-item" data-category="mountains">
          <a href="/listings" class="listing-card-wrapper">
            <div class="custom-card card">
              <div class="card-img-wrapper">
                <img src="https://images.unsplash.com/photo-1502784444187-359ac186c5bb?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Alpine Panorama Chalet">
                <span class="card-badge">RARE FIND</span>
                <button class="wishlist-btn" type="button" onclick="event.preventDefault(); this.classList.toggle('active');"><i class="fa-solid fa-heart"></i></button>
              </div>
              <div class="card-body card-body-custom">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title-custom m-0">Alpine Panorama Chalet</h5>
                  <div class="d-flex align-items-center gap-1 small fw-bold text-dark"><i class="fa-solid fa-star text-warning"></i> 4.96</div>
                </div>
                <p class="card-location-custom"><i class="fa-solid fa-location-dot me-1 text-danger"></i>Zermatt, Switzerland</p>
                <div class="d-flex align-items-baseline gap-1">
                  <span class="card-price-custom">&#8377;<span class="price-number" data-base-price="18900">18,900</span></span>
                  <span class="text-muted fs-6">/ night</span>
                  <span class="tax-info ms-2">+18% GST</span>
                </div>
              </div>
            </div>
          </a>
        </div>

        <div class="col listing-item" data-category="castles">
          <a href="/listings" class="listing-card-wrapper">
            <div class="custom-card card">
              <div class="card-img-wrapper">
                <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Heritage Haveli & Spa">
                <span class="card-badge">HERITAGE</span>
                <button class="wishlist-btn" type="button" onclick="event.preventDefault(); this.classList.toggle('active');"><i class="fa-solid fa-heart"></i></button>
              </div>
              <div class="card-body card-body-custom">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title-custom m-0">Royal Heritage Palace Spa</h5>
                  <div class="d-flex align-items-center gap-1 small fw-bold text-dark"><i class="fa-solid fa-star text-warning"></i> 4.99</div>
                </div>
                <p class="card-location-custom"><i class="fa-solid fa-location-dot me-1 text-danger"></i>Udaipur, India</p>
                <div class="d-flex align-items-baseline gap-1">
                  <span class="card-price-custom">&#8377;<span class="price-number" data-base-price="15400">15,400</span></span>
                  <span class="text-muted fs-6">/ night</span>
                  <span class="tax-info ms-2">+18% GST</span>
                </div>
              </div>
            </div>
          </a>
        </div>

        <div class="col listing-item" data-category="pools">
          <a href="/listings" class="listing-card-wrapper">
            <div class="custom-card card">
              <div class="card-img-wrapper">
                <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Infinity Cliff Villa">
                <span class="card-badge">TOP RATED</span>
                <button class="wishlist-btn" type="button" onclick="event.preventDefault(); this.classList.toggle('active');"><i class="fa-solid fa-heart"></i></button>
              </div>
              <div class="card-body card-body-custom">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title-custom m-0">Infinity Sunset Cliff Villa</h5>
                  <div class="d-flex align-items-center gap-1 small fw-bold text-dark"><i class="fa-solid fa-star text-warning"></i> 4.97</div>
                </div>
                <p class="card-location-custom"><i class="fa-solid fa-location-dot me-1 text-danger"></i>Santorini, Greece</p>
                <div class="d-flex align-items-baseline gap-1">
                  <span class="card-price-custom">&#8377;<span class="price-number" data-base-price="22000">22,000</span></span>
                  <span class="text-muted fs-6">/ night</span>
                  <span class="tax-info ms-2">+18% GST</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  </div>
</section>


